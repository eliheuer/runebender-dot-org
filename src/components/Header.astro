---
type NavLink = { href: string; label: string; external?: boolean; action?: boolean };

const links: NavLink[] = [
  { href: "/docs", label: "Documentation" },
  { href: "https://github.com/eliheuer/runebender-gpui", label: "Source Code", external: true },
  { href: "/gpui/index.html", label: "Launch Editor" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
// On the home page the brand launches the editor; everywhere else it
// goes home.
const isHome = current === "/";
const brandHref = isHome ? "/gpui/index.html" : "/";
const brandLabel = isHome ? "Launch the Runebender editor" : "Runebender home";

const isCurrent = (href: string) => {
  if (href.startsWith("http")) return false;
  const target = href.replace(/\/$/, "") || "/";
  return target === current;
};
---

<header class="site-header">
  <a class="brand" href={brandHref} aria-label={brandLabel}>
    <span>Runebender</span>
  </a>
  <nav aria-label="Primary navigation">
    {
      links.map(({ href, label, action, external }) => (
        <a
          href={href}
          class={action ? "nav-action" : undefined}
          aria-current={isCurrent(href) ? "page" : undefined}
          target={external ? "_blank" : undefined}
          rel={external ? "noreferrer" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
