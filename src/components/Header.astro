---
type NavLink = { href: string; label: string; external?: boolean; action?: boolean };

const links: NavLink[] = [
  { href: "/docs", label: "Documentation" },
  { href: "https://github.com/eliheuer/runebender-xilem", label: "Source Code" },
  { href: "/wasm-editor/", label: "Launch App" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const brandHref = "/";
const brandLabel = "Runebender home";

const isCurrent = (href: string) => {
  if (href.startsWith("http")) return false;
  const target = href.replace(/\/$/, "") || "/";
  return target === current;
};
---

<header class="site-header">
  <a class="brand" href={brandHref} aria-label={brandLabel}>
    <span>Runebender</span>
  </a>
  <nav aria-label="Primary navigation">
    {
      links.map(({ href, label, action, external }) => (
        <a
          href={href}
          class={action ? "nav-action" : undefined}
          aria-current={isCurrent(href) ? "page" : undefined}
          target={external ? "_blank" : undefined}
          rel={external ? "noreferrer" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  @media (max-width: 620px) {
    .site-header { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-header nav { display: contents; }
    .brand, .site-header nav a { border: 0; padding: 12px 16px; }
    .brand, .site-header nav a:nth-child(2) { border-right: 2px solid var(--g-25); }
    .brand, .site-header nav a:first-child { border-bottom: 2px solid var(--g-25); }
  }
</style>
