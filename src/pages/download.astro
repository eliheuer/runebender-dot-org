---
import BaseLayout from "../layouts/BaseLayout.astro";
import release from "../data/release.json";

const artifacts = release.artifacts as Array<{
  platform: string;
  architecture: string;
  url: string;
  sha256: string;
  minimum_os: string;
}>;
---

<BaseLayout title="Download Runebender" description="Download the native Runebender font editor for macOS.">
  <main>
    <section class="section">
      <h1>Download Runebender</h1>
      <p>Runebender is alpha software. Work on copies of important fonts and keep your sources in version control.</p>
      <h2>macOS</h2>
      {release.available && artifacts.length > 0 ? (
        <>
          <p>Version {release.version}</p>
          {artifacts.filter((artifact) => artifact.platform === "macos").map((artifact) => (
            <div>
              <p>
                <a class="button primary" href={artifact.url}>
                  Download for {artifact.architecture === "arm64" ? "Apple Silicon" : "Intel"}
                </a>
              </p>
              <p>Requires macOS {artifact.minimum_os} or later.</p>
              <details><summary>SHA-256 checksum</summary><code class="checksum">{artifact.sha256}</code></details>
            </div>
          ))}
        </>
      ) : (
        <p>The first downloadable alpha, {release.version}, is being prepared. A DMG will appear here after signing and installation checks pass.</p>
      )}
      <ol>
        <li>Open the downloaded DMG and drag Runebender into Applications.</li>
        <li>Eject the disk image, then launch Runebender from Applications.</li>
        <li>Choose File → Open to open a UFO or Designspace.</li>
      </ol>
      {release.available && <p>The app checks for newer alpha releases at launch and asks before installing. Use Runebender → Check for Updates… to check manually. Save your work before restarting.</p>}
      <p><a href="https://github.com/fontgarden/runebender/releases">Release notes and previous downloads on GitHub</a></p>
      <h2>Linux and source builds</h2>
      <p>See the <a href="/docs/install.html">installation guide</a> for Rust and system-library prerequisites. Cargo and Homebrew registry packages are not available yet.</p>
      <p><a href="/wasm-editor/">Try the browser editor</a> without installing the desktop app.</p>
    </section>
  </main>
</BaseLayout>

<style>
  h1, h2, p, ol, details { margin-bottom: 1rem; }
  h2 { margin-top: 2rem; }
  .checksum { overflow-wrap: anywhere; }
</style>
