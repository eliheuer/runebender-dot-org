---
import DocLayout from "../../layouts/DocLayout.astro";
import MiniIndex from "../../components/MiniIndex.astro";

const start = [
  { href: "/docs/install.html", title: "Install", description: "Run it in the browser, or build the native application with cargo." },
  { href: "/docs/tutorial-first-glyph.html", title: "Draw a Glyph", description: "A tutorial: from an empty font to a saved, spaced letter." },
  { href: "/docs/opening.html", title: "Opening and Saving", description: "What opens, what converts, and how saving works." },
  { href: "/docs/concepts.html", title: "Concepts", description: "Sources, the em, outlines, and what interpolation needs." },
  { href: "/docs/architecture.html", title: "Architecture", description: "One headless core, several front-ends, and why." },
  { href: "/docs/interface.html", title: "The Interface", description: "What each panel and bar does." },
];

const editing = [
  { href: "/docs/tools.html", title: "Tools", description: "The eight edit modes and what each one does." },
  { href: "/docs/glyphs.html", title: "Glyphs", description: "Add, rename, encode, group, and remove glyphs." },
  { href: "/docs/paths.html", title: "Paths and Filters", description: "Clean up, combine, and transform outlines." },
  { href: "/docs/components.html", title: "Components and Anchors", description: "Build composites that follow their base." },
  { href: "/docs/masters.html", title: "Masters and Interpolation", description: "Work across a designspace." },
  { href: "/docs/spacing.html", title: "Spacing and Kerning", description: "Widths, metric keys, and kerning by dragging." },
  { href: "/docs/features.html", title: "Feature Code", description: "Edit features.fea, or generate it from names and anchors." },
  { href: "/docs/color.html", title: "Color Fonts", description: "Palettes, layers, and COLRv0 or v1." },
  { href: "/docs/text.html", title: "Text and Shaping", description: "Type in context, including Arabic and other RTL scripts." },
  { href: "/docs/font-info.html", title: "Font Info", description: "Names, vertical metrics, and hinting values." },
  { href: "/docs/checking.html", title: "Checking a Font", description: "Compare masters, measure weights, verify joining." },
];

const localAi = [
  { href: "/docs/agents.html", title: "Agents", description: "Point an AI agent at your sources. The seam is the filesystem." },
  { href: "/docs/local-models.html", title: "Local Models", description: "Run a model on your machine, over your own sources. Experimental." },
];

const learn = [
  { href: "/docs/tutorial-first-glyph.html", title: "Draw a Glyph", description: "A tutorial from empty font to saved letter." },
  { href: "/docs/workflows.html", title: "Workflows", description: "Recipes for jobs that span several parts of the editor." },
];

const reference = [
  { href: "/docs/shortcuts.html", title: "Shortcuts", description: "Every keyboard command and menu item." },
  { href: "/docs/themes.html", title: "Themes", description: "The token file: greys, corners, rule weights, and marks." },
  { href: "/docs/format.html", title: "File Format", description: "What Runebender writes into a UFO." },
  { href: "/docs/exporting.html", title: "Exporting", description: "Build a font file from your sources." },
  { href: "/docs/scripting.html", title: "Scripting", description: "Automating alongside the editor, and what is not there." },
  { href: "/docs/troubleshooting.html", title: "Troubleshooting", description: "What to check when something fails." },
  { href: "/docs/development.html", title: "Development", description: "Build from source and find your way around the code." },
  { href: "/docs/faq.html", title: "FAQ", description: "Short answers, including the uncomfortable ones." },
  { href: "/docs/glossary.html", title: "Glossary", description: "Terms used across these pages." },
];
---

<DocLayout
  title="Overview"
  lede="Runebender edits UFO and designspace font sources. It also opens and edits Glyphs files and compiled fonts, converting them to UFO/Designspace on the way in. These pages cover what it does, how to install it, and how to use it."
  status="Alpha documentation, approximately 80% unedited AI text"
  stability="The editor changes quickly; verify against the source"
  currentSlug="index"
  description="Documentation map for the Runebender font editor."
>
  <section class="doc-section">
    <h2>Read This First</h2>
    <div>
      <p>
        Runebender is alpha software. Keep your font sources under version control
        and work on copies. The editor writes UFO and designspace files in place,
        and a bug can damage them.
      </p>
      <p class="callout">
        Everything on this site describes one editor. Runebender runs in your
        browser and as a native application from the same Rust code.
      </p>
    </div>
  </section>

  <section class="doc-section">
    <h2>Start</h2>
    <div><MiniIndex items={start} /></div>
  </section>

  <section class="doc-section">
    <h2>Editing</h2>
    <div><MiniIndex items={editing} /></div>
  </section>

  <section class="doc-section">
    <h2>AI</h2>
    <div><MiniIndex items={localAi} /></div>
  </section>

  <section class="doc-section">
    <h2>Learn</h2>
    <div><MiniIndex items={learn} /></div>
  </section>

  <section class="doc-section">
    <h2>Reference</h2>
    <div><MiniIndex items={reference} /></div>
  </section>
</DocLayout>
