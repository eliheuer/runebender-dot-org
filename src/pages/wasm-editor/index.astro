---
import build from "../../../public/app/build-info.json";
const { release } = build;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Runebender</title>
    <link rel="canonical" href="https://runebender.org/wasm-editor/" />
    <meta name="description" content="Runebender in your browser. Edit the bundled font, or open and save your own UFO and Designspace folders in Chrome and Edge." />
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="manifest" href="/wasm-editor/manifest.webmanifest" />
    <meta name="theme-color" content="#15131a" />
    <meta name="application-name" content="Runebender" />
  </head>
  <body>
    <iframe src={`/app/index.html?v=${release}`} title="Runebender font editor"></iframe>
  </body>
</html>
<style is:global>
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #aaa; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
