---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import outlineScreenshot from "../assets/runebender-outline.png";
import gridScreenshot from "../assets/runebender-grid.png";
import nodesScreenshot from "../assets/runebender-nodes.png";
---

<BaseLayout
  compact
  title="Runebender"
  description="Runebender is a free, open-source font editor built on the Linebender ecosystem of Rust crates."
>
  <main id="top">
    <section class="hero" aria-label="Runebender font editor">
      <div class="hero-copy">
        <div class="lede">
          <p>
            Runebender is a free and open-source font editor built on the
            <a href="https://linebender.org">Linebender</a> ecosystem of
            <a href="https://www.rust-lang.org">Rust</a> crates.
          </p>
          <p>
            It is designed to be an extensible, flexible base for custom tools and
            workflows. It uses the UFO and Designspace font source formats by
            default and can import Glyphs, Glyphs Package, and single-master
            Babelfont sources.
          </p>
          <p>
            Included is a ComfyUI-like node editor for non-destructive workflows
            and local AI, with built-in support for Designbot, a Rust DrawBot
            alternative built on the Linebender ecosystem.
          </p>
        </div>
        <div class="hero-actions" aria-label="Launch Runebender">
          <a class="button primary" href="/editor/index.html">Launch App</a>
        </div>
      </div>

      <figure class="screenshot-block screenshot-cycle" data-cycle>
        <Image
          class="frame is-shown"
          src={outlineScreenshot}
          alt="Runebender editing an outlined letter R with curvature combs and continuity markers"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="eager"
        />
        <Image
          class="frame"
          src={nodesScreenshot}
          alt="Runebender showing a node workflow: a model boldening a master, compared and installed"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="lazy"
        />
        <Image
          class="frame"
          src={gridScreenshot}
          alt="Runebender showing the Virtua Grotesk glyph grid"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="section install-section" id="install" aria-labelledby="install-title">
      <div>
        <h2 class="section-kicker" id="install-title">Quick Install</h2>
      </div>
      <div class="install-steps">
        <pre><code>cargo install --git https://github.com/eliheuer/runebender-xilem</code></pre>
      </div>
    </section>

    <section class="section resource-section" id="source" aria-labelledby="source-title">
      <div>
        <h2 class="section-kicker" id="source-title">Source Code</h2>
      </div>
      <div class="source-url">
        <a href="https://github.com/eliheuer/runebender-xilem">https://github.com/eliheuer/runebender-xilem</a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  #top { display: grid; grid-template-rows: minmax(240px, 1fr) auto auto; min-height: 0; }
  .hero { grid-template-columns: minmax(260px, .7fr) minmax(0, 1.3fr); gap: 0; padding: 0; min-height: 0; }
  .hero-copy { min-height: 0; padding: 24px; justify-content: flex-start; gap: 20px; }
  .lede p { margin-bottom: 0; }
  .button { padding: 10px 18px; }
  .screenshot-cycle { position: relative; display: grid; min-height: 0; margin: 0; padding: 0; }
  .screenshot-cycle :global(.frame) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 16px; border: 0; opacity: 0; transition: opacity .8s ease; }
  .screenshot-cycle :global(.frame.is-shown) { opacity: 1; }
  .section { display: grid; grid-template-columns: 160px minmax(0, 1fr); align-items: center; gap: 24px; padding: 16px 24px; }
  .section-kicker { margin: 0; }
  pre { margin: 0; padding: 12px 16px; font-size: 16px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .install-steps pre code { white-space: pre-wrap; overflow-wrap: anywhere; }
  .source-url { min-width: 0; }
  .source-url a { overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) { .screenshot-cycle :global(.frame) { transition: none; } }
  @media (max-width: 800px), (max-height: 580px) {
    #top { display: block; }
    .hero { display: grid; grid-template-columns: 1fr; overflow: visible; }
    .hero-copy { max-width: none; width: auto; padding: 20px; }
    .hero-actions, .button { width: auto; }
    .screenshot-cycle { width: 100%; aspect-ratio: 16 / 10; border-left: 0; border-top: 2px solid var(--g-25); }
    .section { grid-template-columns: 1fr; gap: 8px; padding: 16px 20px; }
    pre { font-size: 14px; }
  }
</style>

<script>
  // Cycle the frames. With reduced motion on, the first frame stays.
  const figure = document.querySelector("[data-cycle]");
  const frames = figure ? Array.from(figure.querySelectorAll(".frame")) : [];
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (frames.length > 1 && !still) {
    let shown = 0;
    setInterval(() => {
      frames[shown].classList.remove("is-shown");
      shown = (shown + 1) % frames.length;
      frames[shown].classList.add("is-shown");
    }, 6000);
  }
</script>
