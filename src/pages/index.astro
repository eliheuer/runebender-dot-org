---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import editorScreenshot from "../assets/runebender-xilem-screenshot.png";
---

<BaseLayout
  title="Runebender"
  description="Runebender is a free, open-source font editor built on the Linebender ecosystem of Rust crates."
>
  <main id="top">
    <section class="hero" aria-label="Runebender Web Editor">
      <div class="hero-copy">
        <div class="lede">
          <p>
            Runebender is a free and open-source font editor built on the
            <a href="https://linebender.org">Linebender</a> ecosystem of
            <a href="https://www.rust-lang.org">Rust</a> crates.
          </p>
          <p>
            There are currently two maintained front-ends,
            <a href="https://github.com/linebender/xilem">Xilem</a> and
            <a href="https://www.gpui.rs">GPUI</a>. The default front-end for now uses
            GPUI and runs both cross-platform natively on desktop and in the browser.
            The <a href="https://github.com/eliheuer/runebender-xilem">Xilem version</a>
            is more experimental and less usable, but could be interesting as an example
            of a Xilem application.
          </p>
        </div>
        <div class="hero-actions" aria-label="Launch Runebender">
          <a class="button primary" href="/gpui/index.html">Launch Editor</a>
        </div>
      </div>

      <figure class="screenshot-block">
        <Image
          src={editorScreenshot}
          alt="The Runebender Xilem editor showing a glyph editing workspace"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="eager"
        />
      </figure>
    </section>

    <section class="section install-section" id="install" aria-labelledby="install-title">
      <div>
        <h2 class="section-kicker" id="install-title">Quick Install</h2>
      </div>
      <div class="install-steps">
        <p>Install the editor with cargo.</p>
        <pre><code>cargo install --git https://github.com/eliheuer/runebender-gpui</code></pre>
        <p>Then open a font from anywhere.</p>
        <pre><code>runebender-gpui path/to/Font.designspace</code></pre>
      </div>
    </section>

    <section class="section resource-section" id="source" aria-labelledby="source-title">
      <div>
        <h2 class="section-kicker" id="source-title">Source Code</h2>
      </div>
      <div class="resource-links">
        <a href="https://github.com/eliheuer/runebender-gpui">
          <strong>runebender-gpui</strong>
          <span>The current main editor.</span>
        </a>
        <a href="https://github.com/eliheuer/runebender-xilem">
          <strong>runebender-xilem</strong>
          <span>Xilem-based version, more experimental and less usable.</span>
        </a>
        <a href="https://github.com/eliheuer/runebender-core">
          <strong>runebender-core</strong>
          <span>The headless Rust core of both editors.</span>
        </a>
        <a href="https://github.com/linebender/runebender">
          <strong>runebender-druid</strong>
          <span>The original implementation, kept as project history.</span>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
