---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import editorScreenshot from "../assets/runebender-xilem-screenshot.png";
---

<BaseLayout
  title="Runebender"
  description="Runebender is a free, open-source font editor built on the Linebender ecosystem of Rust crates."
>
  <main id="top">
    <section class="hero" aria-label="Runebender Web Editor">
      <div class="hero-copy">
        <p class="lede">
          Runebender is a free, open-source, permissively licensed font editor built on the
          Linebender ecosystem of Rust crates. A headless core handles the font work, and
          separate front-ends put an interface on it. The current default front-end uses GPUI,
          and the long-term goal is to build the whole application on the Linebender stack:
          Masonry, Xilem, or whatever the ecosystem settles on.
        </p>
        <div class="hero-actions" aria-label="Launch Runebender">
          <a class="button primary" href="/gpui/index.html">Launch Editor</a>
        </div>
      </div>

      <figure class="screenshot-block">
        <Image
          src={editorScreenshot}
          alt="The Runebender Xilem editor showing a glyph editing workspace"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="eager"
        />
      </figure>
    </section>

    <section class="section get-section" id="get" aria-label="Ways to Run Runebender">
      <div class="family-grid">
        <article class="family-card core-card">
          <span>Default · Browser</span>
          <h3><a href="/gpui/index.html">Runebender GPUI</a></h3>
          <p>
            The current editor, compiled to WebAssembly. Variable fonts, Arabic and RTL shaping,
            smart components, and export.
          </p>
        </article>
        <article class="family-card">
          <span>Native · Build From Source</span>
          <h3><a href="/docs/install.html">Runebender Xilem</a></h3>
          <p>
            The native desktop editor, written in Rust on Xilem. The install guide covers the
            build.
          </p>
        </article>
        <article class="family-card">
          <span>Earlier · Browser</span>
          <h3><a href="/cloud/editor/index.html">Runebender Cloud</a></h3>
          <p>
            The first web build. Small and stable, kept for comparison and for links that already
            point at it.
          </p>
        </article>
      </div>
    </section>

    <section class="section resource-section" id="source" aria-labelledby="source-title">
      <div>
        <div class="section-kicker">Source Code</div>
        <h2 id="source-title">Every Repository.</h2>
      </div>
      <div class="resource-links">
        <a href="https://github.com/eliheuer/runebender-gpui">
          <strong>runebender-gpui</strong>
          <span>The current editor. Runs in the browser and as a native app from one codebase.</span>
        </a>
        <a href="https://github.com/eliheuer/runebender-core">
          <strong>runebender-core</strong>
          <span>The headless Rust library. Font operations with no interface attached.</span>
        </a>
        <a href="https://github.com/eliheuer/runebender-xilem">
          <strong>runebender-xilem</strong>
          <span>The native desktop editor built on Xilem.</span>
        </a>
        <a href="https://github.com/eliheuer/runebender-comfy">
          <strong>runebender-comfy</strong>
          <span>Node-based font work as ComfyUI custom nodes.</span>
        </a>
        <a href="https://github.com/linebender/runebender">
          <strong>linebender/runebender</strong>
          <span>The original Druid implementation, kept as project history.</span>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
