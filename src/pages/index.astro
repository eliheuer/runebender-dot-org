---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import editorScreenshot from "../assets/runebender-xilem-screenshot.png";
---

<BaseLayout
  title="Runebender"
  description="Runebender is a free, open-source font editor built on the Linebender ecosystem of Rust crates."
>
  <main id="top">
    <section class="hero" aria-label="Runebender Web Editor">
      <div class="hero-copy">
        <p class="lede">
          Runebender is a free, open-source, permissively licensed font editor built on the
          Linebender ecosystem of Rust crates. A headless core handles the font work, and
          separate front-ends put an interface on it. The current default front-end uses GPUI,
          and the long-term goal is to build the whole application on the Linebender stack:
          Masonry, Xilem, or whatever the ecosystem settles on.
        </p>
        <div class="hero-actions" aria-label="Launch Runebender">
          <a class="button primary" href="/gpui/index.html">Launch Editor</a>
        </div>
      </div>

      <figure class="screenshot-block">
        <Image
          src={editorScreenshot}
          alt="The Runebender Xilem editor showing a glyph editing workspace"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="eager"
        />
      </figure>
    </section>

  </main>
</BaseLayout>
