---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import outlineScreenshot from "../assets/runebender-outline.png";
import gridScreenshot from "../assets/runebender-grid.png";
import nodesScreenshot from "../assets/runebender-nodes.png";
---

<BaseLayout
  title="Runebender"
  description="Runebender is a free, open-source font editor built on the Linebender ecosystem of Rust crates."
>
  <main id="top">
    <section class="hero" aria-label="Runebender font editor">
      <div class="hero-copy">
        <div class="lede">
          <p>
            Runebender is a free and open-source font editor built on the
            <a href="https://linebender.org">Linebender</a> ecosystem of
            <a href="https://www.rust-lang.org">Rust</a> crates.
          </p>
          <p>
            The interface is built with
            <a href="https://github.com/linebender/xilem">Xilem</a>.
            Runebender is alpha software, available as a native desktop application.
          </p>
        </div>
        <div class="hero-actions" aria-label="Install Runebender">
          <a class="button primary" href="/docs/install.html">Install Runebender</a>
          <a class="button" href="/editor/index.html">UI demo</a>
        </div>
      </div>

      <figure class="screenshot-block screenshot-cycle" data-cycle>
        <Image
          class="frame is-shown"
          src={outlineScreenshot}
          alt="Runebender editing an outlined letter R with curvature combs and continuity markers"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="eager"
        />
        <Image
          class="frame"
          src={nodesScreenshot}
          alt="Runebender showing a node workflow: a model boldening a master, compared and installed"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="lazy"
        />
        <Image
          class="frame"
          src={gridScreenshot}
          alt="Runebender showing the Virtua Grotesk glyph grid"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1060px) 100vw, 60vw"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="section install-section" id="install" aria-labelledby="install-title">
      <div>
        <h2 class="section-kicker" id="install-title">Quick Install</h2>
      </div>
      <div class="install-steps">
        <p>Install the editor with cargo.</p>
        <pre><code>cargo +stable install --locked --git https://github.com/eliheuer/runebender-xilem runebender-xilem</code></pre>
        <p>Then open a font from anywhere.</p>
        <pre><code>runebender-xilem path/to/Font.designspace</code></pre>
      </div>
    </section>

    <section class="section resource-section" id="source" aria-labelledby="source-title">
      <div>
        <h2 class="section-kicker" id="source-title">Source Code</h2>
      </div>
      <div class="resource-links">
        <a href="https://github.com/eliheuer/runebender-xilem">
          <strong>runebender-xilem</strong>
          <span>The Runebender font editor.</span>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* Two frames stacked in one grid cell, so each keeps its own aspect
     and the figure takes the taller one; they cross-fade. The frames
     are transparent PNGs with the window's own shadow, so the figure
     draws no border around them and the picture's margin is its own. */
  .screenshot-cycle {
    display: grid;
    padding: 0;
  }
  .screenshot-cycle :global(.frame) {
    grid-area: 1 / 1;
    border: 0;
    transition: opacity 0.8s ease;
    opacity: 0;
  }
  .screenshot-cycle :global(.frame.is-shown) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .screenshot-cycle :global(.frame) {
      transition: none;
    }
  }
</style>

<script>
  // Cycle the frames. With reduced motion on, the first frame stays.
  const figure = document.querySelector("[data-cycle]");
  const frames = figure ? Array.from(figure.querySelectorAll(".frame")) : [];
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (frames.length > 1 && !still) {
    let shown = 0;
    setInterval(() => {
      frames[shown].classList.remove("is-shown");
      shown = (shown + 1) % frames.length;
      frames[shown].classList.add("is-shown");
    }, 6000);
  }
</script>
